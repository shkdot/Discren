# DISCREN Web Application Environment Configuration Template
VITE_APP_NAME=DISCREN
VITE_APP_TAGLINE=B2B Apparel Printing & Production Partner
VITE_APP_LOCATION=Jogeshwari West, Mumbai
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_API_BASE_URL=

# ── Contact form email delivery ──────────────────────────────────────────────
# The site is a static SPA with no backend, so the contact form is relayed to
# info.discren@gmail.com through a free form service. Pick ONE option below.
#
# OPTION 1 (recommended): Web3Forms — free, no server, no card.
#   1. Go to https://web3forms.com and enter info.discren@gmail.com.
#   2. Copy the "Access Key" they email you and paste it below.
VITE_WEB3FORMS_ACCESS_KEY=
#
# OPTION 2: any endpoint that accepts a JSON POST (Formspree / Getform / etc.).
#   Leave blank to fall back to opening the visitor's own mail client.
VITE_FORM_ENDPOINT=
